## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ins.

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Aa]rm/
[Aa]rm64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# Visual Studio 2015/2017/2019/2022 cache/options directory
.vs/
*.vsp
*.vspx

# Test results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# ClickOnce / Office publish
*.publish
publish/

# Local databases & logs
*.mdf
*.ldf
*.db
*.db-shm
*.db-wal
*.log
