<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <OutputType>Library</OutputType>
    <PlatformTarget>x86</PlatformTarget>
    <PlatformTarget Condition="'$(Platform)' == 'x64'">x64</PlatformTarget>
    <Platforms>x86;x64;AnyCPU</Platforms>
    <RootNamespace>WordVstoAddIn</RootNamespace>
    <AssemblyName>WordVstoAddIn</AssemblyName>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <StartAction>Program</StartAction>
    <StartProgram Condition="Exists('C:\Program Files (x86)\Microsoft Office\root\Office16\WINWORD.EXE')">C:\Program Files (x86)\Microsoft Office\root\Office16\WINWORD.EXE</StartProgram>
    <StartProgram Condition="'$(StartProgram)' == '' and Exists('C:\Program Files\Microsoft Office\root\Office16\WINWORD.EXE')">C:\Program Files\Microsoft Office\root\Office16\WINWORD.EXE</StartProgram>
    <StartProgram Condition="'$(StartProgram)' == '' and Exists('C:\Program Files (x86)\Microsoft Office\Office16\WINWORD.EXE')">C:\Program Files (x86)\Microsoft Office\Office16\WINWORD.EXE</StartProgram>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Ribbon.xml" />
    <None Include="App.config">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="App.config">
      <Link>WordVstoAddIn.dll.config</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Visible>false</Visible>
    </None>
    <None Include="Register-WordAddIn.ps1">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="Unregister-WordAddIn.ps1">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Configuration" />
    <Reference Include="System.Net.Http" />
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="office">
      <HintPath>..\WordClient.Core\libs\OFFICE.DLL</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Office.Interop.Word" Version="15.0.4797.1004" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WordClient.Core\WordClient.Core.csproj" />
  </ItemGroup>

</Project>
